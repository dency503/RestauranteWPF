<Window x:Class="RestauranteGestion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestauranteGestion"
        xmlns:viewModels="clr-namespace:RestauranteGestion.ViewModels"
        xmlns:views="clr-namespace:RestauranteGestion.Views"
        Title="Restaurante Gestión" 
        Height="768" Width="1024"
          WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
       >

    <!-- Estilos para la ventana -->
    <Window.Resources>
        <Style TargetType="Button" x:Key="MenuButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="#FF007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0" Background="#FF2D2D30" CornerRadius="10,0,0,10">
            <StackPanel Margin="5">
                <TextBlock Text="Restaurante Gestión" 
                         Foreground="White" 
                         FontSize="18" 
                         FontWeight="Bold"
                         Margin="10,20,10,30"
                         HorizontalAlignment="Center"/>

                <!-- Botones de navegación con comandos MVVM -->
                <Button Content="📊 Dashboard" 
                      Style="{StaticResource MenuButtonStyle}"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="DashboardView"/>

                <Button Content="🍽️ Mesas" 
                      Style="{StaticResource MenuButtonStyle}"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="MesasView"/>

                <Button Content="💰 Ventas" 
                      Style="{StaticResource MenuButtonStyle}"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="VentasView"/>

                <Button Content="📦 Inventario Productos"
        Style="{StaticResource MenuButtonStyle}"
        Command="{Binding NavigateCommand}"
        CommandParameter="InventarioProductosView"/>

                <Button Content="🥬 Inventario Ingredientes"
        Style="{StaticResource MenuButtonStyle}"
        Command="{Binding NavigateCommand}"
        CommandParameter="InventarioIngredientesView"/>


                <Button Content="👨‍🍳 Recetas" 
                      Style="{StaticResource MenuButtonStyle}"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="RecetasView"/>

                <Button Content="📊 Reportes" 
                      Style="{StaticResource MenuButtonStyle}"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="ReportesView"/>

                <Button Content="⚙️ Configuración" 
                      Style="{StaticResource MenuButtonStyle}"
                      Command="{Binding NavigateCommand}"
                      CommandParameter="ConfiguracionView"/>

                <!-- Espacio para expandir -->
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,20">
                    <Button Content="👤 Perfil" 
                          Style="{StaticResource MenuButtonStyle}"
                          Command="{Binding NavigateCommand}"
                          CommandParameter="PerfilView"/>

                    <Button Content="🚪 Salir" 
                          Style="{StaticResource MenuButtonStyle}"
                          Command="{Binding ExitCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Área de contenido principal con ContentControl para MVVM -->
        <!-- Área de contenido principal con ContentControl para MVVM -->
        <Border Grid.Column="1" Background="#FFF5F5F5" CornerRadius="0,10,10,0">
            <ContentControl x:Name="MainContent" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                        <views:DashboardView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ProductosViewModel}">
                        <views:InventarioProductosView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type viewModels:IngredientesViewModel}">
                        <views:InventarioIngredientesView />
                    </DataTemplate>
                    <!-- Agrega más DataTemplates para otras vistas si es necesario -->
                </ContentControl.Resources>
            </ContentControl>
        </Border>

        <!-- Botón para cerrar la ventana (opcional) -->
        <Button Content="X" 
              Width="30" Height="30" 
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,10,10,0" FontWeight="Bold"
              Command="{Binding ExitCommand}"
              Style="{StaticResource MenuButtonStyle}"/>
        
    </Grid>
</Window>