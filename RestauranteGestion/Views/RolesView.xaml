<UserControl x:Class="RestauranteGestion.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ShieldAccount" Foreground="White" Width="32" Height="32" Margin="0,0,10,0"/>
                <TextBlock Text="GESTIÓN DE ROLES"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Área de búsqueda y contenido -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de búsqueda -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox Text="{Binding Filter}" 
                         Width="300" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Buscar rol..."
                         materialDesign:HintAssist.Foreground="#FF3F51B5"
                         materialDesign:TextFieldAssist.UnderlineBrush="#FF3F51B5">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Command="{Binding SearchCommand}" 
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Buscar"
                        Margin="10,0,0,0">
                    <materialDesign:PackIcon Kind="Magnify" Foreground="#FF3F51B5"/>
                </Button>
            </StackPanel>

            <!-- DataGrid de Roles -->
            <Border Grid.Row="1" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4">
                <DataGrid ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRol, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowBackground="White"
                          AlternatingRowBackground="#FFF5F5F5"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdRol}" Width="80"/>
                        <DataGridTextColumn Header="NOMBRE DEL ROL" Binding="{Binding NombreRol}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Botones de acción -->
        <Border Grid.Row="2" Background="White" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#FFE0E0E0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="AGREGAR" Command="{Binding AddCommand}" Margin="5,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FF3F51B5" Foreground="White" Width="120" Height="36"/>

                <Button Content="EDITAR" Command="{Binding EditCommand}" Margin="5,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#FF3F51B5" Foreground="#FF3F51B5" Width="120" Height="36"/>

                <Button Content="ELIMINAR" Command="{Binding DeleteCommand}" Margin="5,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#FFE53935" Foreground="#FFE53935" Width="120" Height="36"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
