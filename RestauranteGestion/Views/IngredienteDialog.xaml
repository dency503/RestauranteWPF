<UserControl x:Class="RestauranteGestion.Views.IngredienteDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="White"
             >

    <StackPanel Margin="20" Width="400">
        <TextBlock Text="{Binding Titulo}" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"
                   Foreground="#FF3F51B5"/>

        <!-- Nombre -->
        <TextBox Text="{Binding Ingrediente.NombreIngrediente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                 materialDesign:HintAssist.Hint="Nombre*"
                 Margin="0,5">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SaveDialogCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <!-- Categoría -->
        <ComboBox ItemsSource="{Binding Categorias}"
          SelectedItem="{Binding CategoriaSeleccionada, Mode=TwoWay}"
          Style="{StaticResource MaterialDesignOutlinedComboBox}"
          materialDesign:HintAssist.Hint="Categoría*"
          Margin="0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding NombreCategoria}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>



        <!-- Cantidad -->
        <TextBox Text="{Binding Ingrediente.Stock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                 materialDesign:HintAssist.Hint="Cantidad*"
                 Margin="0,10">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SaveDialogCommand}"/>
            </TextBox.InputBindings>
            <Validation.ErrorTemplate>
                <ControlTemplate>
                    <StackPanel>
                        <AdornedElementPlaceholder/>
                        <TextBlock Text="{Binding [0].ErrorContent}" 
                                   Foreground="Red" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Validation.ErrorTemplate>
        </TextBox>

        <!-- Unidad de Medida -->
        <ComboBox ItemsSource="{Binding UnidadesMedida}" 
          SelectedItem="{Binding Ingrediente.UnidadMedida, Mode=TwoWay}"
          Style="{StaticResource MaterialDesignOutlinedComboBox}"
          materialDesign:HintAssist.Hint="Unidad de medida*"
          Margin="0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- Botones -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="CANCELAR"
                    Command="{Binding  CancelarCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="#FF3F51B5"
                    Margin="0,0,10,0"/>
            <Button Content="GUARDAR"
                    Command="{Binding GuardarCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#FF3F51B5"
                    Foreground="White"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
