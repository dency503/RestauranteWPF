<UserControl x:Class="RestauranteGestion.Views.PerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="650.237" d:DesignWidth="815.254">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="423*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24"  Background="DarkBlue">
            <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountCircle" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding NombreCompleto}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding Cargo}" Style="{StaticResource MaterialDesignBody2TextBlock}" Foreground="Gray"/>
                <TextBlock Text="{Binding Email}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <!-- Contenido -->
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="0,93,0,0" Grid.RowSpan="3">

            <!-- Información Personal -->
            <materialDesign:Card Padding="20">
                <StackPanel>
                    <TextBlock Text="Información Personal" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Columna izquierda -->
                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Nombre}" materialDesign:HintAssist.Hint="Nombre"   Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,10,10" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Telefono}" materialDesign:HintAssist.Hint="Teléfono"  Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,10,10" />
                        <DatePicker Grid.Row="2" Grid.Column="0" SelectedDate="{Binding FechaNacimiento}"
                                    materialDesign:HintAssist.Hint="Fecha de Nacimiento"
                                    Margin="0,0,10,0" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>

                        <!-- Columna derecha -->
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Apellido}" materialDesign:HintAssist.Hint="Apellido"  Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,0,10" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Direccion}" materialDesign:HintAssist.Hint="Dirección"  Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Margin="0,0,0,10" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Credenciales y Actividad -->
            <materialDesign:Card Padding="20">
                <TabControl>
                    <!-- Tab de credenciales -->
                    <TabItem Header="Credenciales">
                        <StackPanel Margin="0,10,0,0">
                            <TextBox Text="{Binding NombreUsuario}" 
                                      Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     materialDesign:HintAssist.Hint="Nombre de usuario"
                                     IsReadOnly="True"
                                     
                                     Margin="0,0,0,10"/>

                            <PasswordBox materialDesign:HintAssist.Hint="Contraseña actual"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         Margin="0,0,0,10"/>

                            <PasswordBox materialDesign:HintAssist.Hint="Nueva contraseña"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         Margin="0,0,0,10"/>

                            <PasswordBox materialDesign:HintAssist.Hint="Confirmar nueva contraseña"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         Margin="0,0,0,20"/>

                            <Button Content="Cambiar Contraseña" 
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    Foreground="DarkBlue"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Tab de actividad -->
                    <TabItem Header="Actividad">
                        <DataGrid ItemsSource="{Binding ActividadReciente}" 
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Margin="0,10,0,0"
                                  Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}"/>
                                <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="*"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding DireccionIP}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</UserControl>
