<UserControl x:Class="RestauranteGestion.Views.MesaDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White">

    <StackPanel Margin="20" Width="400">
        <TextBlock Text="Mesa" FontSize="18" Margin="0,0,0,10" HorizontalAlignment="Center" />

        <TextBox Text="{Binding Mesa.NumeroMesa, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 Margin="0,10,0,0"
                 materialDesign:HintAssist.Hint="Número de Mesa"
                 InputScope="Number" />

        <TextBox Text="{Binding Mesa.Capacidad, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                 Margin="0,10,0,0"
                 materialDesign:HintAssist.Hint="Capacidad"
                 InputScope="Number" />

        <ComboBox ItemsSource="{Binding Estados}" 
                  SelectedItem="{Binding Mesa.Estado, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                  Margin="0,10,0,0"
                  materialDesign:HintAssist.Hint="Estado de la Mesa"
                  />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Guardar" 
                    Command="{Binding GuardarMesaCommand}" 
                    Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignFlatButton}" />
            <Button Content="Cancelar" 
                    Command="{Binding CancelarCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
