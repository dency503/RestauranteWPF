<UserControl x:Class="RestauranteGestion.Views.InventarioIngredientesView"
             x:Name="InventarioIngredientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RestauranteGestion.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#FF3F51B5" Padding="20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FoodVariant" Foreground="White" Width="32" Height="32" Margin="0,0,10,0"/>
                <TextBlock Text="INVENTARIO DE INGREDIENTES" 
                           FontSize="22" 
                           FontWeight="SemiBold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Área de búsqueda y contenido -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de búsqueda y filtros -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox Text="{Binding Filter}" 
                         Width="300" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Buscar ingrediente..."
                         materialDesign:HintAssist.Foreground="#FF3F51B5"
                         materialDesign:TextFieldAssist.UnderlineBrush="#FF3F51B5">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox ItemsSource="{Binding Categorias}" 
                          SelectedItem="{Binding SelectedCategoria}"
                          DisplayMemberPath="NombreCategoria"
                          Width="200"
                          Margin="10,0,0,0"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Filtrar por categoría"/>

                <Button Command="{Binding SearchCommand}" 
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Buscar"
                        Margin="10,0,0,0">
                    <materialDesign:PackIcon Kind="Magnify" Foreground="#FF3F51B5"/>
                </Button>

                <Button Command="{Binding ClearFiltersCommand}" 
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Limpiar filtros"
                        Margin="10,0,0,0">
                    <materialDesign:PackIcon Kind="FilterRemove" Foreground="#FF3F51B5"/>
                </Button>
            </StackPanel>

            <!-- DataGrid -->
            <Border Grid.Row="1" BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4">
                <DataGrid ItemsSource="{Binding FiltradosIngredientes}" 
                          SelectedItem="{Binding SelectedIngrediente, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowBackground="White"
                          AlternatingRowBackground="#FFF5F5F5"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdIngrediente}" Width="80"
                            HeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding NombreIngrediente}" Width="*"
                            HeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria}" Width="150"
                            HeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Stock}" Width="120"
                            HeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                        <DataGridTextColumn Header="UNIDAD" Binding="{Binding UnidadMedida}" Width="120"
                            HeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                        <DataGridTextColumn Header="ESTADO" Width="120">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stock}" Value="0">
                                            <Setter Property="Text" Value="AGOTADO"/>
                                            <Setter Property="Foreground" Value="#FFE53935"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stock}" Value="{x:Null}">
                                            <Setter Property="Text" Value="N/A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stock}" Value="-1">
                                            <Setter Property="Text" Value="INACTIVO"/>
                                            <Setter Property="Foreground" Value="#FF757575"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Diálogo para categorías -->
        <materialDesign:DialogHost Identifier="MyDialogHost">
            <materialDesign:DialogHost.DialogContent>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="20">
                    <StackPanel>
                        <!-- Contenido del diálogo de categorías -->
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Botones de acción -->
        <Border Grid.Row="2" Background="White" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#FFE0E0E0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="AGREGAR" 
                        Command="{Binding AddCommand}" 
                        Margin="5,0" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FF3F51B5"
                        Foreground="White"
                        Width="120"
                        Height="36"/>

                <Button Content="EDITAR" 
                        Command="{Binding EditCommand}" 
                        Margin="5,0" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#FF3F51B5"
                        Foreground="#FF3F51B5"
                        Width="120"
                        Height="36"/>

                <Button Content="ELIMINAR" 
                        Command="{Binding DeleteCommand}" 
                        Margin="5,0" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#FFE53935"
                        Foreground="#FFE53935"
                        Width="120"
                        Height="36"/>

                <!-- Botón de Administrar Categorías -->
                <Button Command="{Binding ManageCategoriesCommand}" 
                        Margin="5,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#FF4CAF50" 
                        Foreground="#FF4CAF50" 
                        Width="140" 
                        Height="36"
                        ToolTip="Administrar categorías de ingredientes">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShapeOutline" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="CATEGORÍAS"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>