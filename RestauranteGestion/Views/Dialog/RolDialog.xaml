<UserControl x:Class="RestauranteGestion.Views.Dialog.RolDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="White">
    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="{Binding Titulo}" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,20"
                       Foreground="#FF3F51B5"/>

            <TextBox Text="{Binding Rol.NombreRol}" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Nombre del Rol"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelarCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,10,0" Width="100"/>
                <Button Content="Guardar" Command="{Binding GuardarCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FF3F51B5" Foreground="White" Width="100"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
