<UserControl x:Class="RestauranteGestion.Views.ModificacionIngredienteDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="334.615" d:DesignWidth="370.923">
    <Border Background="White" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="Bold" Margin="0 0 0 16"
                       Foreground="{DynamicResource PrimaryHueMidBrush}" />

            <!-- Formulario -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBox Text="{Binding NombreIngrediente, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                         materialDesign:HintAssist.Hint="Ingrediente" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         Margin="0,0,0,12"/>

                <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                         materialDesign:HintAssist.Hint="Cantidad" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         Margin="0,0,0,12"/>

                <ComboBox ItemsSource="{Binding Unidades}" 
                          SelectedItem="{Binding Unidad}" 
                          materialDesign:HintAssist.Hint="Unidad" 
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" 
                          Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Botones -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" />
                <Button Content="GUARDAR"
          Command="{Binding GuardarCommand}"
          Style="{StaticResource MaterialDesignRaisedButton}"
          Background="#FF3F51B5"
          Foreground="White"
          IsDefault="True"/>
              
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
