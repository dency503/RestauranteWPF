<UserControl x:Class="RestauranteGestion.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RestauranteGestion.Helpers"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             Background="#f5f5f5">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" >
        <Border Margin="32"
                Padding="32"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="12"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo y Título en una columna -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,32,0">
                    <materialDesign:PackIcon Kind="Lock" Width="36" Height="36" Foreground="#3F51B5" Margin="0,0,12,0"/>
                    <TextBlock Text="Iniciar Sesión"
                               FontSize="24"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#3F51B5"/>
                </StackPanel>
                <StackPanel>
                    <!-- Usuario -->
                    <TextBox Margin="0,0,0,12"
                             Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Usuario"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Height="40"/>

                    <!-- Contraseña -->
                    <PasswordBox 
                         FlowDirection="LeftToRight"
    Margin="0,0,0,12"
                         materialDesign:HintAssist.Hint="Contraseña"
    local:PasswordHelper.Password="{Binding Contrasenia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Height="40" />

                    <!-- Mensaje de error -->
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource ErrorHueMidBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- Botón de Ingreso -->
                    <Button Command="{Binding LoginCommand}"
        Content="INGRESAR"
        Style="{StaticResource MaterialDesignRaisedButton}"
        Background="#3F51B5"
        Foreground="White"
        FontWeight="Bold"
        Height="45"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Width="100"
        Margin="0,10,0,0"/>

                </StackPanel>

                <!-- Controles en la parte derecha -->
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
